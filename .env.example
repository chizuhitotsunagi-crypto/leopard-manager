# Chatwork API 設定
# Chatwork → 右上のアイコン → サービス連携 → API Token から取得
CHATWORK_API_TOKEN=

# 通知を送るルームID（Chatwork のルームURLの末尾の数字）
# 例: https://www.chatwork.com/#!rid12345678 の場合 12345678
CHATWORK_ROOM_ID=

# 通知時にメンションする Chatwork アカウントID（カンマ区切り）
# 空でも動作します（その場合は @全員 になります）
CHATWORK_MENTION_IDS=

# サーバーポート（変更不要）
PORT=3000

# 通知時刻設定（cron 形式・Asia/Tokyo）
NOTIFY_MORNING_CRON=0 9 * * *          # 朝9時：摂食アラート（7日給餌なし）
NOTIFY_EVENING_CRON=0 18 * * *         # 18時：当日の記入漏れ
NOTIFY_MISSING_NEXT_CRON=0 12 * * *    # 翌日12時：前日分の記入漏れ再リマインド

# 通知を有効にするか（false にするとログのみ）
NOTIFY_ENABLED=true
